# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/public/vendor/

# misc
.DS_Store
*.pem
/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never get committed (BUILD_SPEC principle 2)
.env*
!.env.example

# cloudflare / opennext
/.open-next/
# Salvaged copies of a build that was interrupted or replaced; the plain
# /.open-next/ rule above does not match these renamed snapshots.
/.open-next-*/
/.wrangler/
.dev.vars
cloudflare-env.d.ts

# local build/dev session output — these bury real changes in `git status`
*.log
*.pid

# supabase cli local link state (project ref, pooler url)
/supabase/.temp/

# local sample documents and agent scratch attachments
/Sample/
/.codex-remote-attachments/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json
