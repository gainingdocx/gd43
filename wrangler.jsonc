{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gainingdocx",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  // Zone routes, not custom domains: the DNS records for apex + www already
  // exist (proxied), and the custom-domain API refuses to override them.
  "routes": [
    { "pattern": "gainingdocx.com/*", "zone_id": "16621fb1a09e0c07252c67660e1590bf" },
    { "pattern": "www.gainingdocx.com/*", "zone_id": "16621fb1a09e0c07252c67660e1590bf" }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gainingdocx"
    }
  ]
}
