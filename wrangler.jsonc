{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gainingdocx",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/downloads/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  // Dispatched by expression in custom-worker.ts `scheduled`. The minutely tick
  // drives the webhook retry sweep — its first backoff step is 60s, so a longer
  // interval would make the delivery log's "retrying shortly" untrue.
  "triggers": {
    "crons": ["0 8 * * *", "* * * * *"]
  },
  "vars": {
    "EMAIL_INGEST_DOMAIN": "docs.gainingdocx.com",
    "EMAIL_INGEST_FROM": "reports@docs.gainingdocx.com",
    "NEXT_PUBLIC_APP_URL": "https://gainingdocx.com",
    "PDF_OCR_ENGINE": "mistral-ocr"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["reports@docs.gainingdocx.com", "alerts@docs.gainingdocx.com"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_INGESTION_QUEUE",
        "queue": "gainingdocx-email-ingestion"
      }
    ],
    "consumers": [
      {
        "queue": "gainingdocx-email-ingestion",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "gainingdocx-email-ingestion-dlq",
        "max_concurrency": 2
      }
    ]
  },
  "limits": {
    "cpu_ms": 300000
  },
  "workers_dev": true,
  // Zone routes, not custom domains: the DNS records for apex + www already
  // exist (proxied), and the custom-domain API refuses to override them.
  "routes": [
    { "pattern": "gainingdocx.com/*", "zone_id": "16621fb1a09e0c07252c67660e1590bf" },
    { "pattern": "www.gainingdocx.com/*", "zone_id": "16621fb1a09e0c07252c67660e1590bf" }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gainingdocx"
    }
  ]
}
