{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gainingdocx",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "workers_dev": true,
  // Zone routes, not custom domains: the DNS records for apex + www already
  // exist (proxied), and the custom-domain API refuses to override them.
  "routes": [
    { "pattern": "gainingdocx.com/*", "zone_id": "16621fb1a09e0c07252c67660e1590bf" },
    { "pattern": "www.gainingdocx.com/*", "zone_id": "16621fb1a09e0c07252c67660e1590bf" }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gainingdocx"
    }
  ]
}
