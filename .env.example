# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets must NEVER be committed.
# Where each value comes from is documented in the README ("Environment variables").
OPENROUTER_API_KEY=""
# Optional separate HMAC secret for the anonymous daily document allowance.
# If omitted, OPENROUTER_API_KEY signs the private usage cookie.
GUEST_USAGE_SECRET=""
# Optional model overrides. The defaults use fast Gemma 4 with a denser
# matching-quality escalation only when the first pass is incomplete.
MODEL_PRIMARY="google/gemma-4-26b-a4b-it"
MODEL_ESCALATION="google/gemma-4-31b-it"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Public GA4 web-stream identifier.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-H3XT47WGSF"
SUPABASE_SERVICE_ROLE_KEY=""
# Optional dedicated AES-GCM key material for saved outbound connector credentials.
# When omitted, the server-only Supabase service-role secret derives the encryption key.
INTEGRATION_CREDENTIAL_KEY=""
# Comma-separated account emails allowed to open /app/admin.
# Defaults to gainingdocx@gmail.com when omitted.
ADMIN_EMAILS=""
# Separate administrator portal credentials. Store real values as hosted
# secrets; never commit them to this file.
ADMIN_PORTAL_USERNAME="suhasgovind"
ADMIN_PORTAL_PASSWORD=""
ADMIN_SESSION_SECRET=""
# Session-pooler Postgres connection string (Dashboard -> Connect -> Session pooler).
# Used only by tooling to apply supabase/migrations and run RLS tests.
SUPABASE_DB_URL=""
CLOUDFLARE_ACCOUNT_ID=""
# Cloudflare Email Routing receives at this subdomain. Email Sending and the
# EMAIL binding are configured in wrangler.jsonc, so no third-party API key is needed.
EMAIL_INGEST_DOMAIN="docs.gainingdocx.com"
EMAIL_INGEST_FROM="reports@docs.gainingdocx.com"
NEXT_PUBLIC_APP_URL="https://gainingdocx.com"
# OpenRouter PDF preprocessing used for scan-heavy or image-heavy freight PDFs.
# Cloudflare AI parsing is deliberately unsupported.
PDF_OCR_ENGINE="mistral-ocr"
# Required by the daily Cloudflare charge-alert scheduler.
CRON_SECRET=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_SENTRY_DSN=""
# Paddle billing. Sandbox for build+test; switch PADDLE_ENV to "production" at
# go-live. The app derives environment from the key/token prefixes, so keeping
# these consistent (all sandbox, or all live) is what matters.
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""                        # server: pdl_sdbx_apikey_* / pdl_live_apikey_*
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""       # browser: test_* / live_*
PADDLE_WEBHOOK_SECRET=""                 # per notification destination: pdl_ntfset_*
# Catalog price IDs (not secret). Filled by scripts/seed-paddle-catalog.mjs.
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=""
NEXT_PUBLIC_PADDLE_PRICE_TEAM_MONTHLY=""
# Comma-separated archived price IDs retained only for existing subscriptions.
NEXT_PUBLIC_PADDLE_LEGACY_PRO_PRICE_IDS=""
# Live credentials, stored for the go-live migration; unused while PADDLE_ENV=sandbox.
PADDLE_LIVE_API_KEY=""
PADDLE_LIVE_CLIENT_TOKEN=""
PADDLE_LIVE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY_LIVE=""
NEXT_PUBLIC_PADDLE_PRICE_TEAM_MONTHLY_LIVE=""
NEXT_PUBLIC_PADDLE_LEGACY_PRO_PRICE_IDS_LIVE=""
# Optional operations mailbox. When unset, parse incidents are still recorded
# and visible to administrators but no alert email is sent.
PARSE_ALERT_EMAIL=
