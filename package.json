{
  "name": "gainingdocx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:vendor": "node scripts/prepare-document-vendors.mjs",
    "predev": "npm run prepare:vendor",
    "dev": "next dev --turbopack",
    "prebuild": "npm run prepare:vendor",
    "build": "next build",
    "build:cloudflare": "npm run build && opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@opennextjs/cloudflare": "1.20.1",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.25.0",
    "next": "15.5.20",
    "papaparse": "5.5.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "4.13.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/utif": "3.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.112.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260714.1": true
  }
}
