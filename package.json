{
  "name": "gainingdocx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:vendor": "node scripts/prepare-document-vendors.mjs",
    "predev": "npm run prepare:vendor",
    "dev": "next dev --turbopack",
    "prebuild": "npm run prepare:vendor",
    "build": "next build",
    "check": "npm run lint && tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\" \"components/**/*.test.ts\"",
    "verify:samples": "node --conditions=react-server --import tsx --env-file=.env.local scripts/verify-gemma-samples.ts",
    "verify:regression": "tsx scripts/verify-regression-corpus.ts",
    "verify:regression:live": "node --conditions=react-server --import tsx --env-file=.env.local scripts/verify-regression-corpus.ts --live",
    "verify:e2e": "node --conditions=react-server --import tsx scripts/verify-production-e2e.ts",
    "verify:unicode-pdf": "tsx scripts/verify-unicode-pdf.ts",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "paddle:audit:sandbox": "node scripts/audit-paddle.mjs sandbox",
    "paddle:audit:live": "node scripts/audit-paddle.mjs live",
    "paddle:setup:sandbox": "node scripts/setup-paddle.mjs sandbox",
    "paddle:setup:live": "node scripts/setup-paddle.mjs live --confirm-live"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontpkg/unifont": "15.0.1",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@opennextjs/cloudflare": "1.20.1",
    "@paddle/paddle-js": "1.6.4",
    "@paddle/paddle-node-sdk": "3.8.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "arabic-persian-reshaper": "1.0.1",
    "bidi-js": "1.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.25.0",
    "next": "15.5.23",
    "papaparse": "5.5.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "postal-mime": "2.7.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "regenerator-runtime": "0.14.1",
    "server-only": "0.0.1",
    "shadcn": "4.13.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/utif": "3.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.121.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260804.1": true
  },
  "overrides": {
    "postcss": "8.5.26",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "next": {
      "sharp": "0.35.2"
    }
  }
}
